# Copy this file to frontend/.env and fill in real values.
# frontend/.env is gitignored — never commit it. These are baked into the
# production bundle at build time (npm run build), so set them BEFORE building.

# Base URL the frontend calls for all API requests (ChatWidget, Footer, AdminPage).
# Leave EMPTY for the same-domain deploy (nginx serves the frontend and proxies
# /api/* to the backend on the same origin, laptoptrek.com) so calls are relative
# (/api/chat, /api/enquiries, ...). Only set this to a full URL if the API is
# ever hosted on a different origin than the frontend.
REACT_APP_BACKEND_URL=

# Cloudflare Turnstile site key — used by TurnstileWidget.jsx on the enquiry
# form and LATI chat. Its allowed hostnames are managed in the Cloudflare
# Turnstile dashboard. For local dev, use frontend/.env.local with Cloudflare's
# official test sitekey instead of the real one here (works on any hostname):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
REACT_APP_TURNSTILE_SITE_KEY=

# --- Dev-server only, not used by the production build (npm run build) ---
# WDS_SOCKET_PORT=443
# ENABLE_HEALTH_CHECK=false
