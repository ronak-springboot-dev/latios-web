# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored (see repo .gitignore: .env, .env.*, *.env) — never commit it.

# --- MongoDB ---
MONGO_URL=
DB_NAME=

# --- Admin dashboard (/admin) ---
# Shared secret sent by the frontend as the X-Admin-Key header.
ADMIN_PASSWORD=

# --- LATI chat (Gemini via Emergent's "Universal Key" SDK: emergentintegrations) ---
# IMPORTANT: despite the name, this must hold your Emergent Universal LLM Key
# (the value that looks like "sk-emergent-..."), not a raw Google API key —
# backend/server.py passes this straight into emergentintegrations' LlmChat(api_key=...).
GEMINI_API_KEY=

# --- CORS ---
# Comma-separated list of allowed origins. Do not leave this unset/"*" in production —
# combined with allow_credentials=True in backend/server.py it's an unsafe combination.
# Include http://localhost:3000 too if you also run the frontend locally (npm start).
CORS_ORIGINS=https://laptoptrek.com,https://www.laptoptrek.com,http://localhost:3000

# --- Email alerts (enquiry notifications), via Emergent's managed email proxy ---
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=

# --- Not yet wired into any code (reserved for future use) ---
# Cloudflare Turnstile bot-protection key — no route currently verifies this.
TURNSTILE_SECRET_KEY=
# Emergent's integration proxy base URL, for reference.
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
