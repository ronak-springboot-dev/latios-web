# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored (see repo .gitignore: .env, .env.*, *.env) — never commit it.
# For local-dev-only overrides (e.g. Cloudflare Turnstile test keys), use
# backend/.env.local instead — also gitignored, loaded on top of this file,
# has no effect in production since it won't exist on the deploy target.

# --- MongoDB ---
MONGO_URL=
DB_NAME=

# --- Admin dashboard (/admin) ---
# Shared secret sent by the frontend as the X-Admin-Key header.
ADMIN_PASSWORD=

# --- LATI chat ---
# A real Google Gemini API key from https://aistudio.google.com/apikey
# (starts "AIza..." or similar — backend/server.py calls Google's
# generativelanguage.googleapis.com directly via the google-genai SDK).
GEMINI_API_KEY=

# --- CORS ---
# Comma-separated list of allowed origins. Do not leave this unset/"*" in production —
# combined with allow_credentials=True in backend/server.py it's an unsafe combination.
# Include http://localhost:3000 too if you also run the frontend locally (npm start).
CORS_ORIGINS=https://laptoptrek.com,https://www.laptoptrek.com,http://localhost:3000

# --- Email alerts (enquiry notifications), via Emergent's managed email proxy ---
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=

# --- Cloudflare Turnstile bot-protection ---
# Verified server-side on both POST /api/enquiries and POST /api/chat
# (backend/server.py's verify_turnstile). The widget's allowed hostnames are
# managed in the Cloudflare Turnstile dashboard — must include your production
# domain(s) or submissions get rejected. For local dev, use Cloudflare's
# official test secret in backend/.env.local instead of the real one here:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=
